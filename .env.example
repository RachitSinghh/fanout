# Fanout extension — build-time env (Vite import.meta.env). All values here are PUBLIC.
# Anything bundled into the extension is world-readable — never put secrets here.

# Google OAuth client id (type "Chrome App", must match the extension id).
VITE_GOOGLE_OAUTH_CLIENT_ID=1234-abc.apps.googleusercontent.com

# Public base URL for the web backend (entitlement/telemetry). The deployed Next
# app — NOT an `api.` subdomain. In dev it defaults to http://localhost:3000.
VITE_BACKEND_URL=https://fanout-web.vercel.app

# Public Sentry DSN (PII is scrubbed before send). Optional.
VITE_SENTRY_DSN=

# development | staging | production
VITE_ENV=development
