# ─────────────────────────────────────────────────────────────────────────────
# Fanout web app (packages/web) — copy this to `.env.local` and fill it in.
# Real secrets are NEVER committed (.env*.local is gitignored). Only NEXT_PUBLIC_*
# values are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database: Neon Postgres ─────────────────────────────  (TICKET-038 / 039)
# Neon dashboard → your project → "Connection string".
# DATABASE_URL = the POOLED string (app runtime). Keep ?sslmode=require.
# DIRECT_URL   = the DIRECT (non-pooled) string — Prisma needs it for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/fanout?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/fanout?sslmode=require"

# ── Google Sign-In (identity only — NOT gmail.send) ─────  (TICKET-038)
# Create a NEW "Web application" OAuth client in the SAME Google Cloud project as
# the extension. (The extension's client is a "Chrome App" type — it can't be
# reused for web sign-in.) Scopes: openid, email, profile only — no restricted
# scope, so no OAuth verification is needed for this client.
# Authorized JavaScript origin: http://localhost:3000  (add your prod domain later)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="1234567890-abcdef.apps.googleusercontent.com"
# Only needed IF we use the OAuth redirect/code flow. For the ID-token verify
# flow we plan, leave this unset.
# GOOGLE_CLIENT_SECRET="GOCSPX-..."

# ── Session signing ────────────────────────────────────  (TICKET-038)
# Any 32+ byte random string.  Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# ── Admin dashboard allowlist ──────────────────────────  (SECURITY §2.5 / TICKET-043)
# Comma-separated Google account `sub` ids allowed into /admin.
# You'll get your own `sub` after signing in once — paste it here then.
ADMIN_GOOGLE_SUBS=""

# ── App URL ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Payments: Lemon Squeezy (Merchant of Record) ───────  (TICKET-041 — later)
# Not needed yet; fill when we wire billing.
# LEMONSQUEEZY_API_KEY=""
# LEMONSQUEEZY_STORE_ID=""
# LEMONSQUEEZY_WEBHOOK_SECRET=""
